# Copy to `.env` (git-ignored) and adjust. See DOCUMENTATION/18_DEPLOYMENT_PLAN.md §3.
# Auth-related variables (JWT_SECRET, CV_API_KEY, FERNET_KEY) are not used: decisions D6/D7 in WORKFLOW.md.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=crowdcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crowdcast
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://crowdcast:change-me@127.0.0.1:5432/crowdcast
CORS_ORIGINS=["http://localhost:5173"]
PREDICTION_OFFSET_S=10
RETENTION_DAYS_DATA=365
# MODEL_DIR defaults to <repo>/models
