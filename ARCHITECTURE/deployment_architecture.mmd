%% CROWDCAST — Deployment as implemented (one Windows laptop, CPU only)
%% Details: DOCUMENTATION/18_DEPLOYMENT_PLAN.md (v0.2)
flowchart TB
  Browser[Browser on the same laptop]

  subgraph Host[Windows 11 laptop - everything on 127.0.0.1]
    subgraph Docker[Docker Desktop]
      DB[(postgres:16-alpine<br/>crowdcast-db)]
      PG[[volume crowdcast-pgdata]]
    end
    subgraph Native[Native processes - uv / Python 3.12, Node 24]
      FE[Vite dev server :5173<br/>React dashboard, proxies /api]
      API[uvicorn :8000<br/>crowdcast.api.app]
      CYC[tools.run_predictions --follow<br/>M6 + M7]
      SRC[tools.crowdsim.replay<br/>or tools.vision.run_camera]
    end
    MOD[[models/ - git-ignored<br/>YOLOX ONNX, XGBoost boosters]]
    VID[[videos/, data/ - git-ignored<br/>public clips and datasets]]
  end

  Browser --> FE
  FE -- "/api" --> API
  API --> DB
  CYC --> DB
  SRC -- "POST /api/crowd/observations" --> API
  PG --- DB
  MOD --> CYC
  MOD --> SRC
  VID --> SRC
