%% CROWDCAST — System architecture as implemented (solo scope; DOCUMENTATION/07 §9)
%% Modular monolith: one API process + CLI tools; only PostgreSQL runs in Docker.
flowchart LR
  subgraph Sources[Observation sources - CLI, offline]
    V1[Recorded public clips<br/>REAL]
    SIM[T1 CROWDSIM run + replay<br/>SYNTHETIC]
  end

  subgraph CVT[tools.vision.run_camera - CPU, offline]
    M1[M1 Frame reading<br/>OpenCV, 5 FPS, event time] --> M2[M2 CV Processing<br/>YOLOX ONNX + tiling<br/>ByteTrack in-house]
    M2 --> M3[M3 Aggregation<br/>regions + counting lines<br/>per zone per minute]
  end

  subgraph APIP[API process - uvicorn]
    M8[M8 Backend API<br/>FastAPI, no auth D7]
    ING[Ingestion contract<br/>validation AD-02]
    M5a[M5 Venue Graph]
  end

  subgraph CYC[tools.run_predictions - cycle driver, event time]
    M6[M6 Prediction Engine<br/>FeatureBuilder + XGBoost quantile<br/>conformal offsets, B0 fallback]
    M7[M7 Congestion Risk Engine<br/>levels, risk score, alerts]
    M5b[M5 Venue Graph]
  end

  DB[(M4 PostgreSQL 16<br/>Docker container)]
  REG[[Model registry<br/>models/xgb + model_versions]]
  UI[M9 React Dashboard<br/>Vite dev server]
  T2[T2 tools.training<br/>train, tune, ablation, stats, operational]
  CFG[[YAML config<br/>venues, events, cameras]]

  V1 --> M1
  M3 -- "POST /api/crowd/observations (REAL)" --> M8
  SIM -- "POST /api/crowd/observations (SYNTHETIC)" --> M8
  M8 --> ING
  M8 <--> DB
  M5a --- M8
  CFG -- tools.load_config --> DB
  CFG -- camera YAML --> M2
  M6 -- read 60-min window --> DB
  M5b --- M6
  REG --> M6
  M6 -- predictions --> DB
  M6 --> M7
  M7 -- alerts --> DB
  UI -- "polling 5-30 s" --> M8
  DS[[data/synthetic<br/>SYN-clean, SYN-noisy]]
  SIM -- tools.crowdsim.generate --> DS
  DS -- "splits.json (frozen)" --> T2
  T2 -- write artefacts --> REG
